# TiniTracker Admin Dashboard — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# ── Backend API URL ───────────────────────────────────────────────────────────
# Points to the deployed tinitracker-next server.
# Development:
NEXT_PUBLIC_API_URL=http://localhost:3000
# Production:
# NEXT_PUBLIC_API_URL=https://app.tinitracker.in

# ── Dev Server Port ───────────────────────────────────────────────────────────
PORT=3001
