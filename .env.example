# ──────────────────────────────────────────────────────────────────────────────
# TiniTracker Admin  —  Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ──────────────────────────────────────────────────────────────────────────────

# Backend API URL (points to tinitracker-next server)
# Development:
NEXT_PUBLIC_API_URL=http://localhost:3000
# Production:
# NEXT_PUBLIC_API_URL=https://api.tinitracker.in

# Dev server port (defaults to 3001 to avoid conflict with tinitracker-next on 3000)
PORT=3001
